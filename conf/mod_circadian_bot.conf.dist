[worldserver]

###################################################################################################
# MOD-CIRCADIAN-BOT
# Daily random-bot population curve. Requires mod-playerbots.
#
# When the target is higher than the current online count, playerbots logs more in.
# When the target is lower, this module logs surplus random bots out.
###################################################################################################

# Enable the schedule
# Default: 0
CircadianBot.Enable = 0

# Peak bot count is AiPlayerbot.MaxRandomBots from playerbots.conf (Hour values
# are a percent of that, 0-100). There is no separate CircadianBot peak so the
# two modules cannot disagree.

# How often (ms) to re-check the clock and apply the target
# Default: 30000
CircadianBot.CheckInterval = 30000

# Max random bots to log out per check
# Default: 40
CircadianBot.LogoutsPerTick = 40

# Write a one-line snapshot to the worldserver console (and Server.log + LogFile):
#   CircadianBot: <online> / <target>
# Also prints once when online first matches target:
#   CircadianBot: target reached
# Default: 1
CircadianBot.Logging = 1

# How often (ms) to print that line. Also prints when the local hour changes.
# 0 = only on hour change.
# Default: 300000 (5 minutes)
CircadianBot.LogInterval = 300000

# Append-only status file in LogsDir. Empty string disables the file; Server.log still
# gets the same lines (grep CircadianBot). Survives worldserver restarts (append).
# Default: CircadianBot.log
CircadianBot.LogFile = "CircadianBot.log"

# Percent of AiPlayerbot.MaxRandomBots for each local hour (server timezone).
# Evening fades through midnight into a 02:00-06:00 trough (3am-4am at 3% /
# 120 bots when peak is 4000), then a slow climb to an evening peak at 18:00-20:00.
CircadianBot.Hour00 = 48
CircadianBot.Hour01 = 22
CircadianBot.Hour02 = 5
CircadianBot.Hour03 = 3
CircadianBot.Hour04 = 3
CircadianBot.Hour05 = 5
CircadianBot.Hour06 = 6
CircadianBot.Hour07 = 12
CircadianBot.Hour08 = 20
CircadianBot.Hour09 = 28
CircadianBot.Hour10 = 34
CircadianBot.Hour11 = 40
CircadianBot.Hour12 = 48
CircadianBot.Hour13 = 52
CircadianBot.Hour14 = 58
CircadianBot.Hour15 = 66
CircadianBot.Hour16 = 80
CircadianBot.Hour17 = 92
CircadianBot.Hour18 = 100
CircadianBot.Hour19 = 100
CircadianBot.Hour20 = 100
CircadianBot.Hour21 = 96
CircadianBot.Hour22 = 84
CircadianBot.Hour23 = 68
