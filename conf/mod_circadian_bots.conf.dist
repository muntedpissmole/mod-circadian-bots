[worldserver]

###################################################################################################
# MOD-CIRCADIAN-BOTS
# Daily random-bot population curve. Requires mod-playerbots.
#
# When the target is higher than the current online count, playerbots logs more in.
# When the target is lower, this module logs surplus random bots out.
###################################################################################################

# Enable the schedule
# Default: 1
CircadianBot.Enable = 1

# Peak bot count is AiPlayerbot.MaxRandomBots from playerbots.conf (Hour values
# are a percent of that, 0-100). There is no separate CircadianBot peak so the
# two modules cannot disagree.

# How often (ms) to re-check the clock and apply the target
# Default: 30000
CircadianBot.CheckInterval = 30000

# Max random bots to log out per check
# Default: 40
CircadianBot.LogoutsPerTick = 40

# Write a one-line snapshot to the worldserver console (and Server.log + LogFile):
#   CircadianBot: <online> / <target>
# Also prints once when online first matches target:
#   CircadianBot: target reached
# Default: 1
CircadianBot.Logging = 1

# How often (ms) to print that line. Also prints when the local hour changes.
# 0 = only on hour change.
# Default: 300000 (5 minutes)
CircadianBot.LogInterval = 300000

# Append-only status file in LogsDir. Empty string disables the file; Server.log still
# gets the same lines (grep CircadianBot). Survives worldserver restarts (append).
# Default: CircadianBot.log
CircadianBot.LogFile = "CircadianBot.log"

# Percent of AiPlayerbot.MaxRandomBots for each local hour (server timezone).
# These are the values at the top of the hour; the module blends toward
# the next hour through the 60 minutes so bots start walking before the
# clock ticks (city hangout uses the same curve).
# Weekday: evening fades through midnight into a 2am-6am trough, then a
# slow climb to an evening peak at 6pm-8pm (work/school pattern).
CircadianBot.Hour00 = 48
CircadianBot.Hour01 = 22
CircadianBot.Hour02 = 5
CircadianBot.Hour03 = 3
CircadianBot.Hour04 = 3
CircadianBot.Hour05 = 5
CircadianBot.Hour06 = 6
CircadianBot.Hour07 = 12
CircadianBot.Hour08 = 20
CircadianBot.Hour09 = 28
CircadianBot.Hour10 = 34
CircadianBot.Hour11 = 40
CircadianBot.Hour12 = 48
CircadianBot.Hour13 = 52
CircadianBot.Hour14 = 58
CircadianBot.Hour15 = 66
CircadianBot.Hour16 = 80
CircadianBot.Hour17 = 85
CircadianBot.Hour18 = 90
CircadianBot.Hour19 = 100
CircadianBot.Hour20 = 100
CircadianBot.Hour21 = 96
CircadianBot.Hour22 = 84
CircadianBot.Hour23 = 68

# Saturday and Sunday (local tm_wday). Typical MMO/Steam weekend: later
# nights, much busier mornings, then a high plateau from midday through late.
# Saturday 10am is already ~72% of peak; 1pm-9pm sits at 94-100%.
CircadianBot.Weekend.Hour00 = 62
CircadianBot.Weekend.Hour01 = 38
CircadianBot.Weekend.Hour02 = 14
CircadianBot.Weekend.Hour03 = 8
CircadianBot.Weekend.Hour04 = 6
CircadianBot.Weekend.Hour05 = 8
CircadianBot.Weekend.Hour06 = 16
CircadianBot.Weekend.Hour07 = 28
CircadianBot.Weekend.Hour08 = 42
CircadianBot.Weekend.Hour09 = 58
CircadianBot.Weekend.Hour10 = 72
CircadianBot.Weekend.Hour11 = 82
CircadianBot.Weekend.Hour12 = 90
CircadianBot.Weekend.Hour13 = 94
CircadianBot.Weekend.Hour14 = 96
CircadianBot.Weekend.Hour15 = 98
CircadianBot.Weekend.Hour16 = 100
CircadianBot.Weekend.Hour17 = 100
CircadianBot.Weekend.Hour18 = 100
CircadianBot.Weekend.Hour19 = 100
CircadianBot.Weekend.Hour20 = 100
CircadianBot.Weekend.Hour21 = 98
CircadianBot.Weekend.Hour22 = 90
CircadianBot.Weekend.Hour23 = 78

###################################################################################################
# CITY HANGOUT
# While enabled, Stormwind and Orgrimmar aim for MajorHub bodies
# at the bank / auction house (Trade District, Valley of Strength)
# when the hourly schedule is at 100%. Other hours scale with that
# same table (28% at 9am weekday → 28% of MajorHub). Ironforge /
# Undercity / Shattrath / Dalaran get half; Darnassus / Thunder
# Bluff / Exodar / Silvermoon get 30%. MajorHub is independent of
# AiPlayerbot.MaxRandomBots.
###################################################################################################

# Enable city hangout. CircadianBot.Enable must also be on.
# Default: 1
CircadianBot.CityHangout.Enable = 1

# Once bots have mostly logged in after a worldserver start, teleport
# to snap each hub to the current hourly crowd (fountain / extras out
# to the world). After that they walk. Off = 0.
# Default: 1
CircadianBot.CityHangout.SeedOnStart = 1

# Min bots that start a gryphon or overland trip toward a hub per check.
# When a hub is far behind the hourly curve this scales up (up to x8)
# so the square fills during the afternoon ramp, not after peak.
# Default: 3
CircadianBot.CityHangout.NudgesPerTick = 3

# Minimum level to send into a hub (Shattrath 58+, Dalaran 68+ still apply)
# Default: 10
CircadianBot.CityHangout.MinLevel = 10

# How long a newly arrived bot is biased to linger (seconds). After this
# they may head out even if the square is still below target.
# Default: 480-1200 (8-20 minutes)
CircadianBot.CityHangout.MinSession = 480
CircadianBot.CityHangout.MaxSession = 1200

# Stormwind / Orgrimmar crowd when the hourly schedule is at 100%.
# Mid hubs get half; smaller capitals get 30%. Scales with Hour00-23
# / Weekend.Hour00-23. Independent of MaxRandomBots — raise it to
# pack the cities, lower it to leave more people in the world.
# This is a cap: extras (playerbots camping at inns / flying in) are
# sent back out to grind. They are not logged out.
# Default: 100
CircadianBot.CityHangout.MajorHub = 100
